# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Banco de dados (PostgreSQL via Docker) ───────────────────────────────────
DATABASE_URL="postgresql://raiz_user:raiz_pass@localhost:5432/raizdonordeste?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=SUBSTITUA_POR_SEGREDO_FORTE_DE_256BITS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_FORTE
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Tentativas de login por minuto por IP
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# ─── Gateway de Pagamento Mock ────────────────────────────────────────────────
PAYMENT_GATEWAY_URL=https://mock-payment.raizdonordeste.local
PAYMENT_GATEWAY_TIMEOUT_MS=5000

# ─── Cache (in-memory) ────────────────────────────────────────────────────────
CACHE_TTL_CARDAPIO_SECONDS=120

# ─── Fidelidade ───────────────────────────────────────────────────────────────
# R$ 1,00 = 1 ponto
FIDELIDADE_PONTOS_POR_REAL=1
# 100 pontos = R$ 5,00
FIDELIDADE_VALOR_POR_100_PONTOS=5
# 12 meses sem movimentação → expirar pontos
FIDELIDADE_EXPIRACAO_MESES=12

# ─── Logger ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Seed: Usuário ADMIN padrão (criado automaticamente na primeira inicialização) ──
# Altere as credenciais abaixo antes de iniciar a API pela primeira vez
SEED_ADMIN_EMAIL=admin@raizdonordeste.com.br
SEED_ADMIN_SENHA=Admin@123456
